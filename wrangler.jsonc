{
  "name": "watchtower",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchtower-db",
      "database_id": "1fc5ac53-7f44-42e9-8271-a8d4705bd83d",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": []
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://purple-water-c1ac.cloudflareaccess.com",
    "ACCESS_AUD": "25904f3b122e917960103b7459f699e42a5132f470969ec24349f7d0ebf4410a"
  },
  "observability": {
    "enabled": true
  }
}
